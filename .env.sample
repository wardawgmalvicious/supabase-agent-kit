# Copy to the repo root as .env. Never commit the filled-in copy (.gitignore covers it).
#
# Project ref: Project Settings > General, or the <ref> in https://<ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
#
# A SCOPED personal access token: Dashboard > Account > Access Tokens.
# Scope it to this one project, with Read-only access.
# Not a legacy full-access token, which reaches every project on the account.
SUPABASE_ACCESS_TOKEN=<sbp_scoped_token>
#
# Optional, for write mode (-w) only: a second scoped token for this one project
# with Full access, which can also change the project's settings and API keys.
# Give it a short expiry and revoke it when done. Leave it out to stay read-only.
# SUPABASE_ACCESS_TOKEN_RW=<sbp_full_scoped_token>
