{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "mcp__github-mcp__get_commit",
      "mcp__github-mcp__get_file_contents",
      "mcp__github-mcp__list_commits"
    ],
    "ask": [
      "mcp__supabase__execute_sql",
      "mcp__supabase__query_logs",
      "Bash(*supabase-query.sh*-w*)",
      "PowerShell(*supabase-query.sh*-w*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(printenv *SUPABASE_ACCESS_TOKEN*)",
      "Bash(echo *SUPABASE_ACCESS_TOKEN*)",
      "Bash(printf *SUPABASE_ACCESS_TOKEN*)",
      "PowerShell(*SUPABASE_ACCESS_TOKEN*)"
    ]
  }
}
